# Vardha Voice Connect — local settings
APP_NAME=Vardha Voice Connect — AI Voice Calling Agent
# APP_VERSION is authoritative in VERSION.txt and is not read from .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-this-local-secret
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DEFAULT_TIMEZONE=Asia/Kolkata

# Leave DATABASE_URL empty for the simple local SQLite database.
# On Render, paste the Internal Database URL from your Render PostgreSQL service.
DATABASE_URL=

# Exotel
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_STREAMTYPE=bidirectional
EXOTEL_STREAM_SAMPLE_RATE=8000
EXOTEL_STREAM_AUDIO_CONTENT_TYPE=audio/x-l16;rate=8000
EXOTEL_RECORD=true
EXOTEL_TIME_LIMIT=1800

# AI provider
# Gemini is the default real-time provider. OpenAI variables are kept as optional legacy settings.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_VOICE=Kore
GEMINI_VOICE_PRIMARY=Kore
GEMINI_VOICE_FEMALE=Aoede
GEMINI_ALLOWED_VOICE_IDS=Kore,Aoede

# Optional: configure a real transfer destination only when your Exotel flow supports it.
HUMAN_HANDOFF_NUMBER=

# Optional legacy OpenAI settings (not required when AI_PROVIDER=gemini)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_VOICE=coral
OPENAI_REALTIME_INPUT_FORMAT=audio/pcm
OPENAI_REALTIME_OUTPUT_FORMAT=audio/pcm

# Public deployment operator protection. In non-debug deployments this defaults to enabled.
# Set the credentials in the real .env/Render environment; never commit them.
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Local calls need a public tunnel because Exotel cannot reach localhost.
# Example:
# PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
# On Render, leave this blank and the app uses RENDER_EXTERNAL_HOSTNAME automatically.
PUBLIC_BASE_URL=

# Voice bridge safety. Keep the test tone disabled.
SEND_TEST_TONE=false
